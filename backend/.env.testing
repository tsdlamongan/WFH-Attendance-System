# ---------------------------------------------------------------------------
# Test / E2E environment  (make cover, make test, scripts/run-e2e.mjs)
#
# Laravel loads this file INSTEAD of .env whenever APP_ENV=testing: phpunit.xml
# sets it for the test suite, the E2E runner and the Makefile export it. Keep it
# self-contained and free of real secrets; it is committed on purpose.
# ---------------------------------------------------------------------------

APP_NAME="WFH Attendance System"
APP_ENV=testing
# Fixed throwaway key so the E2E tokens are reproducible. Never reuse outside tests.
APP_KEY=base64:VJRXrzxJJRCytx0zsicofq7fIM1Yfi48A1jN3JF2re0=
APP_DEBUG=true
APP_URL=http://127.0.0.1:10003
APP_TIMEZONE=Asia/Jakarta
# `php artisan serve` default port for the E2E backend (frontend/.env.testing points here)
SERVER_PORT=10003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Cheap hashing: thousands of users are created during the suite
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# E2E stack: a throwaway sqlite file (relative to backend/) that run-e2e.mjs recreates,
# migrates and seeds on every run. PHPUnit overrides this with :memory: (see phpunit.xml).
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array

# The E2E frontend (vite --mode testing) runs on :10004
SANCTUM_STATEFUL_DOMAINS=localhost:10004,127.0.0.1:10004
FRONTEND_URL=http://localhost:10004
CORS_ALLOWED_ORIGINS=http://localhost:10004

# Rate limiters are disabled in the testing environment (bootstrap/app.php)
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=60
RATE_LIMIT_WHATSAPP=10

# RecaptchaService skips verification when APP_ENV=testing; any value works
RECAPTCHA_SECRET_KEY=e2e-test-secret-bypassed
ENABLE_REGISTRATION=true

# Never call Gemini from tests: keeps the evaluation report deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EVALUATION_REPORT_AI_SUMMARY=true
