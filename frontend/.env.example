# Local development — copy to .env (make up reads it)
# Backend API base URL, includes /api/v1 (SERVER_PORT in backend/.env)
VITE_API_URL=http://localhost:10001/api/v1

# Google reCAPTCHA v2 site key. The value below is Google's official TEST key: it always
# passes and shows a "for testing purposes only" banner. Replace it for production.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

VITE_ENABLE_REGISTRATION=true
