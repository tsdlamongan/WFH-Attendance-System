# E2E / test environment — loaded by `vite --mode testing` (Playwright webServer in
# playwright.config.js, started through scripts/run-e2e.mjs). Vite layers it over .env, so
# every value that differs from local development must be set here. Committed on purpose.

# E2E backend (SERVER_PORT in backend/.env.testing)
VITE_API_URL=http://localhost:10003/api/v1

# Official Google TEST site key — always passes.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

VITE_ENABLE_REGISTRATION=true

# Bypass the captcha widget on Login/Register during E2E
VITE_E2E_TEST=true
